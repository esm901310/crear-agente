{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lechon-playero",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Las pantallas (Vite build -> dist/) van empaquetadas dentro del Worker
  // (worker/pantallas.generated.ts, lo genera `npm run build`). El Worker
  // atiende /api/* y sirve las pantallas para todo lo demás.

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comandas-db",
      // Base de producción en Cloudflare (creada en la Entrega 4).
      // En local (`--local`) wrangler usa una copia aparte en .wrangler/.
      "database_id": "9aeb084b-472a-4f26-8bbc-0b21e8802d82",
      "migrations_dir": "migrations"
    }
  ]
}
