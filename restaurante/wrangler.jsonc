{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comandas-restaurante",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Las pantallas (Vite build -> dist/) se sirven como archivos estáticos.
  // Todo lo que empiece con /api/ lo atiende primero el Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comandas-db",
      // PENDIENTE: reemplazar al publicar (Entrega 4) con el id que da
      // `npx wrangler d1 create comandas-db`. En local no se usa.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
